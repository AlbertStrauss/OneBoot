#! /bin/sh
# OneBoot: generate cloud-init NoCloud seed for subiquity autoinstall
# from kernel cmdline (oneboothost= onebootpass= onebootcidr= ip= BOOTIF=).
# Injected into the official casper initrd by build.sh; runs as a
# casper-bottom hook with the live root mounted at /root.

PREREQ=""
DESCRIPTION="OneBoot: generating autoinstall seed..."

prereqs()
{
       echo "$PREREQ"
}

case $1 in
# get pre-requisites
prereqs)
       prereqs
       exit 0
       ;;
esac

# ${oneboot_*} overrides exist only so src/seed-test.sh can drive this without a
# live boot; in the initramfs they are the real paths.
. "${oneboot_casper_functions:-/scripts/casper-functions}"

log_begin_msg "$DESCRIPTION"

C=$(cat "${oneboot_cmdline:-/proc/cmdline}")

# MANUAL mode: the menu drops the `autoinstall` keyword. Bail out WITHOUT
# writing the NoCloud seed - subiquity treats any autoinstall: key in
# cloud-init user-data as "go ahead and install" even without the kernel
# arg, which would silently wipe the disk on a manual install.
if ! echo "$C" | tr ' ' '\n' | grep -qx autoinstall || ! echo "$C" | tr ' ' '\n' | grep -qx 'oneboot.autoinstall=1'; then
    log_end_msg
    exit 0
fi

zget() {
    echo "$C" | tr ' ' '\n' | sed -n "s/^$1=//p" | head -n1
}

PROFILE=${oneboot_profile:-/oneboot-profile}
H=$(sed -n 's/^HOSTNAME=//p' "$PROFILE" 2>/dev/null)
PH=$(sed -n 's/^PASSWORD_HEX=//p' "$PROFILE" 2>/dev/null)
case "$H" in ''|*[!a-zA-Z0-9.-]*|[-.]*|*[-.]) echo 'OneBoot: invalid hostname profile' >&2; exit 1 ;; esac
case "$PH" in ''|*[!0-9a-f]* ) echo 'OneBoot: missing password profile' >&2; exit 1 ;; esac
[ $((${#PH} % 2)) -eq 0 ] || exit 1

# Credentials stay in a private RAM profile, outside the archived YAML.
CIDR=$(zget onebootcidr)
IPCFG=$(zget ip)
IP=$(echo "$IPCFG" | cut -d: -f1)
GW=$(echo "$IPCFG" | cut -d: -f3)
MAC=$(zget BOOTIF | sed 's/^01-//' | tr - :)
# ip=<ip>::<gw>:<mask>:<host>::none:<ns1>:<ns2> - counting the empty fields,
# that puts the resolvers at 8 and 9. They are what the LIVE environment should
# resolve with; the installed system gets its own list from the autoinstall
# network stanza below.
NS1=$(echo "$IPCFG" | cut -d: -f8)
NS2=$(echo "$IPCFG" | cut -d: -f9)
[ -n "$NS1" ] || NS1=8.8.8.8
[ -n "$NS2" ] || NS2=$NS1

# escape for sed replacement
HS=$(echo "$H" | sed 's/[\/&]/\\&/g')

ONEBOOTROOT=${oneboot_root:-/root}
D=$ONEBOOTROOT/var/lib/cloud/seed/nocloud
mkdir -p "$D"

# The disk rule every automated entry shares (src/oneboot-disks), for the
# early-command in the template below. The menu appends it to the initrd root,
# which the live system no longer sees once casper switch_roots - so it goes
# into the live root, like the seed itself. A copy that fails to land makes
# that early-command fail, and subiquity stops before touching any disk.
mkdir -p "$ONEBOOTROOT/usr/local/sbin"
cp "${oneboot_disks:-/oneboot-disk}" "$ONEBOOTROOT/usr/local/sbin/oneboot-disks" || exit 1
cp "${oneboot_set_password:-/oneboot-set-password}" "$ONEBOOTROOT/usr/local/sbin/oneboot-set-password" || exit 1
chmod 755 "$ONEBOOTROOT/usr/local/sbin/oneboot-disks" "$ONEBOOTROOT/usr/local/sbin/oneboot-set-password"
LIVE_RUN=${oneboot_run:-/run}
mkdir -p "$LIVE_RUN"
# initramfs-tools moves this tmpfs to the live system's /run at switch-root.
cp "$PROFILE" "$LIVE_RUN/oneboot-profile" || exit 1
chmod 600 "$LIVE_RUN/oneboot-profile"

cat > "$D/meta-data" <<EOF
instance-id: oneboot-$H
local-hostname: $H
EOF

# template: no shell expansion (quoted heredoc), placeholders swapped after
cat > "$D/user-data" <<'ZEOF'
#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: no
  apt:
    # No install ever pulls updates: the base system comes out of the ISO's
    # own pool, and every pocket that could add a newer package mid-install is
    # switched off. It makes installs deterministic (two servers built a month
    # apart get the same bits) and, on a slow path, it is the difference
    # between installing from local media and dragging packages over a
    # 6 Mbit/s link. The suites are put back on the installed system by a
    # late-command below - frozen during the install, normal afterwards.
    disable_suites: [security, updates, backports, proposed]
    # geoip picks the country mirror (ro.archive..., de.archive..., ...)
    # instead of the single global host. The old hardcoded
    # primary: http://archive.ubuntu.com/ubuntu/ was the slowest possible
    # choice on exactly the networks this product runs on - the box that
    # pulled the ISO at 0.87 MB/s from Canonical would have fetched every
    # package over that same path, and kept it in sources.list forever.
    geoip: true
    # If the chosen mirror is unusable, install from the ISO rather than
    # sitting on a dead connection: the live image already carries everything
    # a default server install needs.
    fallback: offline-install
  # Third-party driver detection reaches out to the network mid-install and
  # buys nothing on a server with Intel NICs and no GPU.
  drivers:
    install: false
  ssh:
    install-server: true
    allow-pw: true
  # Select one eligible fixed disk. Stop on active holders; no all-disk wipe.
  # Subiquity re-reads this YAML after early-commands set the exact path.
  early-commands:
    - |
      set -e; t=$(sh /usr/local/sbin/oneboot-disks); sed -i "s|@ZDISK@|$t|" /autoinstall.yaml
  storage:
    layout:
      name: direct
      # The FIRST disk, like every other entry. Without a match subiquity
      # takes the LARGEST disk - a data disk, on most servers that have one.
      match:
        path: '@ZDISK@'
    swap:
      size: 0
  packages:
    - openssh-server
  user-data:
    package_update: false
    package_upgrade: false
    # subiquity copies its logs AND this autoinstall config verbatim into
    # /var/log/installer on the installed system at the very end of the run -
    # after every late-command - and those logs record the kernel command
    # line, onebootpass= included. First boot is the first moment anything can
    # reach them, which is exactly when this cloud-init runcmd fires.
    write_files:
      - path: /usr/local/sbin/oneboot-scrub
        permissions: '0700'
        content: |
          #!/bin/sh
          find /var/log/installer -type f 2>/dev/null | while read -r f; do
              sed -i 's/onebootpass=[^[:space:]]*/onebootpass=<redacted>/g' "$f" 2>/dev/null || :
          done
          rm -f /usr/local/sbin/oneboot-scrub
    runcmd:
      - [ /usr/local/sbin/oneboot-scrub ]
  interactive-sections: []
  identity:
    hostname: '@ZH@'
    username: user
    # "!" = locked. subiquity needs the field, but this file is archived onto
    # the installed disk, so it must never carry a usable hash. The real
    # credentials are set from /proc/cmdline in the late-commands below.
    password: "!"
  late-commands:
    # The identity user is NOT reliably present in /target at late-command
    # time: 24.04/26.04 subiquity creates it during the install, but
    # 22.04/25.10 delegate identity to cloud-init on FIRST BOOT - so a bare
    # "user:...  | chpasswd" fails with pam_chauthtok on those releases, and
    # subiquity aborts a fully-completed install over it (verified in the
    # install matrix: ubu2204/ubu2510 died exactly here, ubu2404/ubu2604
    # passed). Create the account here when it is missing; cloud-init treats
    # an existing user as "already provisioned" and leaves it - and its
    # password - alone.
    - |
      bash /usr/local/sbin/oneboot-set-password
    - |
      curtin in-target --target=/target -- sh -c 'mkdir -p /etc/ssh/sshd_config.d; printf "PermitRootLogin yes\nPasswordAuthentication yes\n" > /etc/ssh/sshd_config.d/00-oneboot-access.conf'
    # Pin the installed system's datasource list. Left alone, cloud-init on a
    # bare-metal box probes for EC2/Azure/GCE metadata on EVERY boot - it
    # cannot know there is no cloud under it - and each boot stalls in
    # "Job cloud-init-network.service/start running (4min 51s / 5min 6s)"
    # before giving up. Measured on a freshly installed server on 2026-09-15.
    # NoCloud first (subiquity leaves a seed in the target, which is what runs
    # the first-boot scrub above), None as the terminator: both are local, so
    # the search ends immediately and nothing waits on a network that will
    # never answer. cloud-init still runs - this only stops it guessing.
    - |
      curtin in-target --target=/target -- sh -c 'mkdir -p /etc/cloud/cloud.cfg.d && printf "# OneBoot: bare metal - do not probe cloud metadata endpoints\ndatasource_list: [ NoCloud, None ]\n" > /etc/cloud/cloud.cfg.d/90-oneboot-datasource.cfg'
    # Put the pockets back for the INSTALLED system. disable_suites above is
    # about the install, not about shipping servers that can never receive a
    # security fix - without this the box would sit on release-day packages
    # forever. Handles both layouts: deb822 (24.04+) keeps suites on a
    # Suites: line, older releases comment the deb lines out. The mirror URI
    # is left exactly as the installer chose it.
    - |
      curtin in-target --target=/target -- sh -c 'C=$(. /etc/os-release; echo "$VERSION_CODENAME"); F=/etc/apt/sources.list.d/ubuntu.sources; if [ -s "$F" ]; then sed -i -E "s|^Suites:.*|Suites: $C $C-updates $C-security $C-backports|" "$F"; else sed -i -E "s~^# *(deb .*(-updates|-security|-backports).*)~\\1~" /etc/apt/sources.list; fi'
    - |
      curtin in-target --target=/target -- sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash net.ifnames=0 biosdevname=0"/' /etc/default/grub
    - |
      curtin in-target --target=/target -- update-grub
    # A sources.list.d drop-in, not >> /etc/apt/sources.list: releases on
    # deb822 (ubuntu.sources) ship no monolithic sources.list to append to.
    - |
      curtin in-target --target=/target -- bash -c 'echo "deb http://security.ubuntu.com/ubuntu $(lsb_release -cs)-security main restricted universe multiverse" > /etc/apt/sources.list.d/oneboot-security.list'
ZEOF

sed -i "s/@ZH@/$HS/g" "$D/user-data"

# static network for the installed system, matched by boot NIC MAC
if [ -n "$IP" ] && [ -n "$CIDR" ] && [ -n "$GW" ] && [ -n "$MAC" ]; then
cat >> "$D/user-data" <<ZEOF
  network:
    version: 2
    ethernets:
      onebootnic:
        dhcp4: false
        dhcp6: false
        match:
          macaddress: "$MAC"
        addresses: [ $IP/$CIDR ]
        routes:
          - to: default
            via: $GW
            on-link: true
        nameservers:
          addresses: [ $NS1, $NS2 ]
ZEOF
fi

# --- network for the LIVE environment ---------------------------------------
# Without this file cloud-init has no network config for the installer image
# itself, falls back to DHCP on the boot NIC, and on a static-only network
# there is nothing to answer: cloud-init-network.service then sits in
# "start running (Xmin / no limit)" forever and the install never begins.
# Observed in the field on 2026-09-15 at 9 minutes and counting; never seen in
# the matrix because QEMU's user-mode network always answers DHCP, so every
# automated run had a lease handed to it.
#
# NoCloud reads network-config from the seed directory, so the live image gets
# the same static address the operator typed into the menu - the one the
# initramfs is already using.
if [ -n "$IP" ] && [ -n "$CIDR" ] && [ -n "$GW" ] && [ -n "$MAC" ]; then
cat > "$D/network-config" <<ZEOF
version: 2
ethernets:
  onebootnic:
    match:
      macaddress: "$MAC"
    dhcp4: false
    dhcp6: false
    addresses: [ $IP/$CIDR ]
    routes:
      - to: default
        via: $GW
        on-link: true
    nameservers:
      addresses: [ $NS1, $NS2 ]
ZEOF
fi

# Backstop: even with the file above, cloud-init's network stage has no
# TimeoutStartSec of its own - "no limit" is systemd quoting the unit. A stage
# that cannot finish should fail and let the boot continue (the installer then
# comes up interactively, which is visible) rather than hang a server nobody
# can see. Five minutes is far longer than the stage takes when it works.
mkdir -p "$ONEBOOTROOT/etc/systemd/system/cloud-init-network.service.d"
cat > "$ONEBOOTROOT/etc/systemd/system/cloud-init-network.service.d/99-oneboot-timeout.conf" <<'ZEOF'
[Service]
TimeoutStartSec=300
ZEOF

log_end_msg

