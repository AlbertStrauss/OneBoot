#!/bin/bash
# OneBoot: provision credentials from a private live-RAM profile.
set -eu
PROFILE=${oneboot_live_profile:-/run/oneboot-profile}
HEX=$(sed -n 's/^PASSWORD_HEX=//p' "$PROFILE")
case "$HEX" in ''|*[!0-9a-f]*) echo 'OneBoot: invalid credential profile' >&2; exit 1 ;; esac
[ $((${#HEX} % 2)) -eq 0 ] || exit 1
# Hex is transport encoding, not encryption. Never trace or print its value.
ESCAPED=$(printf '%s' "$HEX" | sed 's/../\\x&/g')
# bash printf supports \xHH on all three target Ubuntu versions.
PASSWORD=$(printf '%b' "$ESCAPED")
[ -n "$PASSWORD" ] || exit 1
curtin in-target --target=/target -- bash -c 'getent passwd user >/dev/null || useradd -m -s /bin/bash -G sudo user'
printf 'root:%s\nuser:%s\n' "$PASSWORD" "$PASSWORD" | chpasswd --root /target
unset PASSWORD HEX ESCAPED
rm -f "$PROFILE"
