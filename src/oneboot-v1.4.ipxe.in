:boot_ubuntu_legacy_live
set ubuntu_url ${base_url}/ubuntu/${ubuntu_version}
set ubuntu_iso ${base_url}/ubuntu/ubuntu-${ubuntu_version}-live-server-amd64.iso
echo
echo Starting ${ubuntu_name}
echo The complete ISO downloads to RAM over authenticated HTTPS.
echo 4 GiB RAM recommended. No autoinstall or automatic disk selection is supplied.
echo
imgfree
set ob_boot_resource ${ubuntu_url}/vmlinuz
kernel ${ubuntu_url}/vmlinuz initrd=initrd boot=casper root=/dev/ram0 BOOTIF=${bootif} ip=${validated_ip}::${validated_gateway}:${validated_netmask}:::none oneboot.iso=${ubuntu_iso} oneboot_legacy=1 oneboot.prefix=${input_prefix} oneboot.dns=${validated_dns} cloud-config-url=/dev/null --- || oberror kernel ${ubuntu_url}/vmlinuz ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto ubuntu_legacy_download_failed
initrd --name initrd ${ubuntu_url}/initrd || oberror initrd ${ubuntu_url}/initrd ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto ubuntu_legacy_download_failed
boot || oberror boot ${ob_boot_resource} ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto ubuntu_legacy_boot_failed

:boot_ubuntu_legacy_net
set ubuntu_net_url ${base_url}/ubuntu/netboot/${ubuntu_net_version}
echo
echo Starting Ubuntu ${ubuntu_net_version} net install (legacy)
echo The signed kernel and initrd load over HTTPS; packages come from archive.ubuntu.com.
echo Network defaults are provided. Partitioning and installation remain interactive.
echo
imgfree
set ob_boot_resource ${ubuntu_net_url}/linux
kernel ${ubuntu_net_url}/linux initrd=initrd.gz BOOTIF=${bootif} netcfg/choose_interface=${nic_mac} netcfg/disable_autoconfig=true netcfg/get_ipaddress=${validated_ip} netcfg/get_netmask=${validated_netmask} netcfg/get_gateway=${validated_gateway} netcfg/get_nameservers=${validated_dns} netcfg/confirm_static=true mirror/country=manual mirror/http/hostname=archive.ubuntu.com mirror/http/directory=/ubuntu mirror/http/proxy= mirror/suite=${ubuntu_net_suite} apt-setup/security_host=security.ubuntu.com || oberror kernel ${ubuntu_net_url}/linux ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto ubuntu_legacy_download_failed
initrd --name initrd.gz ${ubuntu_net_url}/initrd.gz || oberror initrd ${ubuntu_net_url}/initrd.gz ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto ubuntu_legacy_download_failed
boot || oberror boot ${ob_boot_resource} ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto ubuntu_legacy_boot_failed

:ubuntu_legacy_download_failed
