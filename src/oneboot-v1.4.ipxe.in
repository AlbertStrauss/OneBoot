:boot_windows_pe
set winpe_url ${base_url}/tools/windows-pe/${winpe_version}
echo
echo Starting OneBoot Windows PE Maintenance
echo Source: official Microsoft ADK 10.1.26100.2454 with KB5101684 applied.
echo The WinPE image loads into RAM. OneBoot does not modify disks automatically.
echo
imgfree
set ob_boot_resource ${winpe_url}/wimboot
kernel ${winpe_url}/wimboot quiet || oberror kernel ${winpe_url}/wimboot ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto winpe_download_failed
initrd --name bootmgr ${winpe_url}/bootmgr bootmgr || oberror initrd ${winpe_url}/bootmgr ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto winpe_download_failed
initrd --name BCD ${winpe_url}/BCD BCD || oberror initrd ${winpe_url}/BCD ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto winpe_download_failed
initrd --name boot.sdi ${winpe_url}/boot.sdi boot.sdi || oberror initrd ${winpe_url}/boot.sdi ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto winpe_download_failed
initrd --name boot.wim ${winpe_url}/boot.wim boot.wim || oberror initrd ${winpe_url}/boot.wim ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto winpe_download_failed
boot || oberror boot ${ob_boot_resource} ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto winpe_boot_failed

