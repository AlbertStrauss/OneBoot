oberror --show
prompt --key 0x1b Press Esc to return to Ubuntu versions... ||
goto ${ubuntu_legacy_menu}

:ubuntu_legacy_boot_failed
echo
echo ERROR: Ubuntu could not be started after downloading its boot files.
echo OneBoot supplies no automatic disk actions.
oberror --show
prompt --key 0x1b Press Esc to return to Ubuntu versions... ||
goto ${ubuntu_legacy_menu}

:proxmox_menu
menu --name proxmox_menu Select Proxmox VE version (Testing)
item --menu proxmox_menu --gap -- Testing: verify full install and first boot on real hardware
item --menu proxmox_menu --key 1 boot_proxmox_9 Proxmox VE 9.2 (Testing)
item --menu proxmox_menu --key 2 boot_proxmox_8 Proxmox VE 8.4 (Testing)
item --menu proxmox_menu --key 3 boot_proxmox_7 Proxmox VE 7.4 (Testing)
item --menu proxmox_menu --gap --
item --menu proxmox_menu --key b main_menu Back to OneBoot menu
item --menu proxmox_menu --key e network_form Edit network settings
item --menu proxmox_menu --key n nic_menu Select another NIC
item --menu proxmox_menu --key s shell Open iPXE shell
item --menu proxmox_menu --key r reboot Reboot server
choose --menu proxmox_menu proxmox_choice || goto proxmox_menu
goto ${proxmox_choice}

:boot_proxmox_9
set proxmox_version 9.2-1
goto boot_proxmox

:boot_proxmox_8
set proxmox_version 8.4-1
goto boot_proxmox

:boot_proxmox_7
set proxmox_version 7.4-1
goto boot_proxmox

:boot_proxmox
set proxmox_url ${base_url}/proxmox/${proxmox_version}
echo
echo Starting Proxmox VE ${proxmox_version} graphical installer (Testing)
echo Loading the original ISO into RAM over authenticated HTTPS.
echo 8 GiB RAM recommended. Confirm the final network settings inside Proxmox.
echo No unattended installation or automatic disk selection is supplied.
echo Testing: validate the complete installation and first boot on real hardware.
echo
imgfree
set ob_boot_resource ${proxmox_url}/linux26
kernel ${proxmox_url}/linux26 root=/dev/ram0 ro ramdisk_size=16777216 rw quiet splash=silent || oberror kernel ${proxmox_url}/linux26 ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto proxmox_download_failed
initrd --name initrd.img ${proxmox_url}/initrd-pxe.img || oberror initrd ${proxmox_url}/initrd-pxe.img ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto proxmox_download_failed
initrd --name oneboot-proxmox-init ${proxmox_url}/init-oneboot-v1.0 /init mode=755 || oberror initrd ${proxmox_url}/init-oneboot-v1.0 ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto proxmox_download_failed
initrd --name proxmox.iso ${proxmox_url}/proxmox.iso /proxmox.iso || oberror initrd ${proxmox_url}/proxmox.iso ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto proxmox_download_failed
boot || oberror boot ${ob_boot_resource} ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto proxmox_boot_failed

:proxmox_download_failed
imgfree
echo
echo ERROR: A required Proxmox file could not be downloaded.
echo Check the link, network settings and OneBoot server allowlist.
echo No installer was started and no disk was touched.
oberror --show
prompt --key 0x1b Press Esc to return to Proxmox versions... ||
goto proxmox_menu

:proxmox_boot_failed
imgfree
echo
echo ERROR: Proxmox could not start. Check available RAM and firmware compatibility.
echo No OneBoot disk automation exists.
oberror --show
prompt --key 0x1b Press Esc to return to Proxmox versions... ||
goto proxmox_menu
