initrd --name BCD ${minitool_url}/BCD BCD || oberror initrd ${minitool_url}/BCD ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto minitool_download_failed
initrd --name boot.sdi ${minitool_url}/boot.sdi boot.sdi || oberror initrd ${minitool_url}/boot.sdi ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto minitool_download_failed
initrd --name boot.wim ${minitool_url}/boot.wim boot.wim || oberror initrd ${minitool_url}/boot.wim ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto minitool_download_failed
boot || oberror boot ${ob_boot_resource} ${nic} ${nic_mac} ${validated_ip}/${input_prefix} ${validated_gateway} ${validated_dns} || goto minitool_boot_failed

